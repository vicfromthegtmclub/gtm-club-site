# Build output. Vercel generates this on every deploy, it must never be committed.
dist/

# Dependencies
node_modules/

# Local env files. Keep secrets (KV tokens, LOG_SECRET, ...) in Vercel, never here.
.env
.env.*
!.env.example

# Vercel CLI local state (project/org ids)
.vercel/

# Local preview files
preview*.html

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
